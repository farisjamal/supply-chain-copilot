# Pick ONE provider and set its key. Copy this file to .env

# Option A: Anthropic (recommended)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Option B: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Option C: Ollama (free, local — install from https://ollama.com, then `ollama pull llama3.2`)
# LLM_PROVIDER=ollama

# Optional: override the default model for the chosen provider
# LLM_MODEL=claude-sonnet-5
